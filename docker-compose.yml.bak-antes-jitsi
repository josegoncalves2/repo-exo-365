# ===================================================================
# eXo Platform Community 7.2.1 — Stack completa (substituição Office 365)
# Host: 192.168.1.59 (pmoexo) — 4 vCPU / 9945 MB RAM
#
# Baseada no docker-compose.yml oficial de
#   github.com/exo-docker/exo-community (master)
# com os seguintes desvios DELIBERADOS, todos justificados em AUDIT.md:
#   1. Versão fixada em 7.2.1 — última estável (2026-07-30). A tag :latest
#      aponta para a linha 7.1.x de 2026-01-20, 7 meses atrás. Verificado
#      na API do Docker Hub em [034].
#   2. Segredos aleatórios em .env (o upstream traz senhas públicas fixas
#      'my-secret-pw' / 'my-super-secret-pw').
#   3. Limites de memória por container. O upstream não limita nada e o
#      host Proxmox já matou esta VM por OOM três vezes ([022],[025],[029]).
#   4. Healthchecks reais nos 8 serviços (o upstream não tem nenhum).
#   5. Mailpit — SMTP de captura, para COMPROVAR os fluxos de e-mail (T-10).
#   6. Synapse + PostgreSQL — ausentes do compose oficial. Na linha 7.x o eXo
#      trocou o chat nativo pela integração Matrix: sem homeserver o chat
#      não existe (T-08) e o boot ainda perde ~5 min tentando conectar.
#   7. Binários em filesystem (EXO_FILE_STORAGE_TYPE=fs), não em RDBMS.
#   8. Log de acesso do Tomcat habilitado (auditoria).
#
# PERSISTÊNCIA — LEIA ANTES DE MEXER
# ----------------------------------
# Todo o estado vive em BIND MOUNTS sob ./data/, e não em volumes nomeados.
# Em 2026-08-12 os dados do responsável foram destruídos por um
# `docker compose down -v`: a flag -v apaga volumes nomeados. Com bind mounts
# esse comando passa a NÃO apagar nada, e `docker system prune --volumes`
# também não os atinge.
#
#   ./data/exo-codec  guarda as CHAVES DE CRIPTOGRAFIA. Sem elas o banco
#   se torna ILEGÍVEL. Precisa ser copiado JUNTO com ./data/mysql.
#
# Donos dos diretórios (UIDs verificados dentro de cada imagem):
#   mysql -> 999:999   es -> 1000:0   exo -> 999:1001   postgres -> 999:999
# ===================================================================

name: exo

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "20m"
    max-file: "5"

services:

  # NENHUM serviço declara `restart:` de propósito.
  # A política de reinício do Docker sobe TODOS os containers ao mesmo tempo
  # quando o daemon inicia, e isso tem dois efeitos indesejados aqui:
  #   1. pico de memória no boot — foi o que fez o hipervisor matar esta VM
  #      três vezes (AUDIT [022], [025], [029]);
  #   2. o nginx no ar antes do eXo, registrando `connect() failed (111)` por
  #      10-20 min — `depends_on: service_healthy` só vale para
  #      `docker compose up`, não para a política de reinício do daemon.
  # A subida é feita pela unidade systemd `exo.service`, que executa
  # scripts/subir-ordenado.sh: um serviço por vez, com trava de memória, e o
  # proxy por último. Ver AUDIT [047].

  # ----------------------------------------------------------------
  # Proxy reverso — único ponto de entrada (porta 80)
  # Roteia / para o eXo e as rotas de documento para o ONLYOFFICE
  # ----------------------------------------------------------------
  web:
    image: ${NGINX_IMAGE}
    container_name: exo-web
    ports:
      - "${EXO_HTTP_PORT:-80}:80"
    volumes:
      - ./conf/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./conf/static:/usr/share/nginx/html:ro
    networks:
      default:
        aliases:
          - ${EXO_PROXY_VHOST}
    depends_on:
      # service_HEALTHY, não service_started. Com "started" o nginx sobe junto
      # com o Tomcat e passa ~15 min tentando alcançar um backend que ainda
      # não escuta, registrando dezenas de:
      #   [error] connect() failed (111: Connection refused) while connecting
      #           to upstream ... request: "GET /portal/ HTTP/1.1"
      # Esperar o eXo ficar saudável elimina a causa (e não o sintoma):
      # o proxy só passa a existir quando há o que servir.
      exo:
        condition: service_healthy
      onlyoffice:
        condition: service_healthy
    mem_limit: 128m
    healthcheck:
      # Aponta para /nginx-health (servido pelo próprio nginx), NÃO para "/".
      # Usar "/" faria o proxy ser reportado como doente sempre que o eXo
      # estivesse iniciando (502), confundindo "backend ainda subindo" com
      # "proxy quebrado". Usa 127.0.0.1 e não 'localhost': o wget do BusyBox
      # resolve localhost para ::1 primeiro, e isso já reportou o nginx como
      # doente estando são ([031]).
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/nginx-health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging: *default-logging

  # ----------------------------------------------------------------
  # eXo Platform — aplicação principal (Tomcat + JDK 21)
  # ----------------------------------------------------------------
  exo:
    image: ${EXO_IMAGE}
    container_name: exo-app
    environment:
      TZ: ${TZ}

      # --- Proxy frontend ---
      EXO_PROXY_VHOST: ${EXO_PROXY_VHOST}
      EXO_PROXY_PORT: ${EXO_PROXY_PORT}
      EXO_PROXY_SSL: ${EXO_PROXY_SSL}

      # --- Banco de dados ---
      EXO_DB_TYPE: mysql
      EXO_DB_HOST: mysql
      EXO_DB_PORT: 3306
      EXO_DB_NAME: ${EXO_DB_NAME}
      EXO_DB_USER: ${EXO_DB_USER}
      EXO_DB_PASSWORD: ${EXO_DB_PASSWORD}
      EXO_DB_TIMEOUT: 300
      EXO_DB_POOL_IDM_MAX_SIZE: 20
      EXO_DB_POOL_JCR_MAX_SIZE: 20
      EXO_DB_POOL_JPA_MAX_SIZE: 20

      # --- Busca (Elasticsearch) ---
      EXO_ES_HOST: es
      EXO_ES_PORT: 9200
      EXO_ES_SCHEME: http
      EXO_ES_INDEX_REPLICA_NB: 0
      EXO_ES_INDEX_SHARD_NB: 1
      EXO_ES_TIMEOUT: 300

      # --- JVM (dimensionada para 9945 MB de RAM total) ---
      EXO_JVM_SIZE_MIN: ${EXO_JVM_SIZE_MIN}
      EXO_JVM_SIZE_MAX: ${EXO_JVM_SIZE_MAX}
      EXO_JVM_METASPACE_SIZE_MAX: ${EXO_JVM_METASPACE_SIZE_MAX}
      EXO_JVM_USER_LANGUAGE: ${EXO_JVM_USER_LANGUAGE}
      EXO_JVM_USER_REGION: ${EXO_JVM_USER_REGION}
      EXO_JVM_LOG_GC_ENABLED: "true"

      # --- Armazenamento: binários em filesystem (backup e performance) ---
      EXO_DATA_DIR: /srv/exo
      EXO_FILE_STORAGE_TYPE: fs
      EXO_JCR_FS_STORAGE_ENABLED: "true"
      EXO_UPLOAD_MAX_FILE_SIZE: 500

      # --- Tomcat ---
      EXO_HTTP_THREAD_MAX: 200
      EXO_HTTP_THREAD_MIN: 10
      EXO_ACCESS_LOG_ENABLED: "true"
      EXO_GZIP_ENABLED: "true"

      # --- E-mail (SMTP) ---
      EXO_MAIL_FROM: ${EXO_MAIL_FROM}
      EXO_MAIL_SMTP_HOST: ${EXO_MAIL_SMTP_HOST}
      EXO_MAIL_SMTP_PORT: ${EXO_MAIL_SMTP_PORT}
      EXO_MAIL_SMTP_STARTTLS: ${EXO_MAIL_SMTP_STARTTLS}
      EXO_MAIL_SMTP_USERNAME: ${EXO_MAIL_SMTP_USERNAME}
      EXO_MAIL_SMTP_PASSWORD: ${EXO_MAIL_SMTP_PASSWORD}

      # --- Conversão de documentos (JOD/LibreOffice embutido) ---
      EXO_JODCONVERTER_PORTS: "2002,2003,2004"

      # --- Carteira de recompensas (gamificação) ---
      EXO_REWARDS_WALLET_ADMIN_KEY: ${EXO_REWARDS_WALLET_ADMIN_KEY}

      # --- Monitoramento ---
      EXO_JMX_ENABLED: "true"
      EXO_JMX_RMI_SERVER_HOSTNAME: exo

      # --- Integração ONLYOFFICE (edição colaborativa de documentos) ---
      JAVA_OPTS: >-
        -Donlyoffice.documentserver.host=${EXO_PROXY_VHOST}
        -Donlyoffice.documentserver.schema=${EXO_PROXY_SCHEMA}
        -Donlyoffice.documentserver.allowedhosts=localhost,onlyoffice,${EXO_PROXY_VHOST}
        -Donlyoffice.documentserver.accessOnly=false
        -Donlyoffice.documentserver.secret=${ONLYOFFICE_JWT_SECRET}
    volumes:
      - ./data/exo:/srv/exo
      # CHAVES DE CRIPTOGRAFIA — copiar sempre junto com ./data/mysql
      - ./data/exo-codec:/etc/exo/codec:rw
      - ./data/exo-logs:/var/log/exo
      - ./conf/exo.properties:/etc/exo/exo.properties:ro
      # NUNCA montar nada sob /opt/exo/webapps/<app>/ — ver AUDIT [075].
      # /opt/exo/webapps contém ARQUIVOS .war, não diretórios. Um bind mount
      # em /opt/exo/webapps/<app>/qualquer/coisa faz o Docker criar o
      # diretório /opt/exo/webapps/<app>/ (root:root) antes do Tomcat subir;
      # o Tomcat encontra um diretório de webapp já existente, não consegue
      # removê-lo (é ponto de montagem), NÃO desempacota o .war e implanta o
      # diretório praticamente vazio como se fosse a aplicação.
      # Duas montagens assim existiam aqui e destruíam duas webapps:
      #   ./conf/i18n      -> .../digital-workplace/WEB-INF/classes/locale/...
      #   ./conf/webdav-web.xml -> .../webdav/WEB-INF/web.xml
      # Como digital-workplace é quem fornece o site myworkspace, sua
      # navegação e suas páginas, o portal inteiro passou a responder
      # HTTP 200 com corpo VAZIO, com NullPointerException em
      # PortalURLContext._render(). Os três arquivos passaram a ser
      # injetados DENTRO dos .war em tempo de build — ver Dockerfile.exo.
    depends_on:
      mysql:
        condition: service_healthy
      es:
        condition: service_healthy
      mailpit:
        condition: service_started
      onlyoffice:
        condition: service_started
    mem_limit: ${MEM_LIMIT_EXO}
    healthcheck:
      # /portal/login é servido pelo portal e responde 200 SEM autenticação,
      # somente depois que o Tomcat termina de implantar as ~70 webapps.
      # (A rota /rest/v1/platform/info, usada antes, NÃO EXISTE na 7.2.1 —
      #  devolve 404 e deixaria o container eternamente "unhealthy".)
      test: ["CMD-SHELL", "curl -fsS -o /dev/null http://localhost:8080/portal/login || exit 1"]
      interval: 30s
      timeout: 15s
      retries: 40
      start_period: 300s
    logging: *default-logging

  # ----------------------------------------------------------------
  # MySQL 8.4 — banco de dados (IDM + JCR + JPA)
  # ----------------------------------------------------------------
  mysql:
    image: ${MYSQL_IMAGE}
    container_name: exo-mysql
    command: --mysql-native-password=OFF
    environment:
      TZ: ${TZ}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${EXO_DB_NAME}
      MYSQL_USER: ${EXO_DB_USER}
      MYSQL_PASSWORD: ${EXO_DB_PASSWORD}
    volumes:
      - ./data/mysql:/var/lib/mysql
      - ./conf/mysql.cnf:/etc/mysql/conf.d/exo.cnf:ro
      # PKI de 2 níveis — ver o comentário em conf/mysql.cnf. Elimina o
      # aviso MY-010068 (CA autoassinada) mantendo a conexão cifrada.
      - ./conf/mysql-certs:/etc/mysql/certs:ro
      # Diretório do pid-file com modo 750 (os padrões /var/run/mysqld e
      # /var/lib/mysql têm modo 1777 e disparam o aviso MY-011810).
      - ./data/mysql-run:/var/lib/mysql-run
    mem_limit: ${MEM_LIMIT_MYSQL}
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root -p\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 60s
    logging: *default-logging

  # ----------------------------------------------------------------
  # Elasticsearch 8.18 — busca unificada (documentos, pessoas, atividades)
  # ----------------------------------------------------------------
  es:
    image: ${ES_IMAGE}
    container_name: exo-es
    environment:
      - TZ=${TZ}
      - ES_JAVA_OPTS=-Xms${ES_HEAP} -Xmx${ES_HEAP}
      - node.name=exo
      - cluster.name=exo
      # cluster.initial_master_nodes NÃO aparece aqui de propósito.
      # Ele serve APENAS ao primeiro start (bootstrap do cluster). Mantê-lo
      # depois faz o ES avisar, a cada início:
      #   "this node is locked into cluster UUID [...] but
      #    [cluster.initial_master_nodes] is set to [exo]; remove this setting
      #    to avoid possible data loss caused by subsequent cluster bootstrap"
      # `discovery.type=single-node` substitui o bootstrap explícito: o nó se
      # elege sozinho, sem a variável e sem o aviso — e é o que descreve esta
      # instalação, que é de nó único por desenho.
      - discovery.type=single-node
      - network.host=_site_
      # http.host=0.0.0.0 é OBRIGATÓRIO: com apenas network.host=_site_ (valor
      # do upstream), a camada HTTP liga somente no IP do container e qualquer
      # verificação via localhost falha com "Couldn't connect" — foi o que
      # travou o primeiro deploy. Não expõe nada ao host: 9200 não é publicada.
      - http.host=0.0.0.0
      - xpack.security.enabled=false
      - xpack.ml.enabled=false
      # NÃO acrescentar `xpack.inference.enabled`: essa opção NÃO EXISTE no
      # Elasticsearch 8.18.8 e o servidor se RECUSA A INICIAR com ela —
      # testado, com o nó em laço de reinício:
      #   java.lang.IllegalArgumentException: unknown setting
      #   [xpack.inference.enabled] did you mean [xpack.ent_search.enabled]?
      # O ES valida as opções na inicialização e trata desconhecida como
      # erro fatal, não como aviso. O aviso de "default inference endpoint
      # IDs [rainbow-sprinkles]" ocorre porque o serviço de inferência tenta
      # agir antes de o estado do cluster ser recuperado.
      #
      # MEDIDO: em nó único iniciando do zero o aviso **se repete**:
      #   [WARN] Failed to revoke access to default inference endpoint IDs:
      #          [rainbow-sprinkles] ... ClusterBlockException: blocked by:
      #          [SERVICE_UNAVAILABLE/1/state not recovered / initialized]
      # É transitório e se resolve sozinho quando o estado do cluster é
      # recuperado — o serviço de inferência tenta agir cedo demais. Como a
      # opção para desligar o módulo não existe nesta versão, eleva-se o
      # nível APENAS do logger que o emite. Nenhum outro logger é afetado:
      # a raiz continua em INFO e qualquer erro real do ES aparece.
      # O ajuste é feito em conf/es-log4j2.properties (montado abaixo):
      # passar `logger.<nome>=ERROR` por variável de ambiente NÃO funciona —
      # a variável chega ao container, mas o ES não a converte em ajuste de
      # logger. Verificado com `docker inspect` + leitura do log.
      - bootstrap.memory_lock=false
    volumes:
      - ./data/elasticsearch:/usr/share/elasticsearch/data:rw
      - ./conf/es-log4j2.properties:/usr/share/elasticsearch/config/log4j2.properties:ro
    ulimits:
      nofile: { soft: 65536, hard: 65536 }
      memlock: { soft: -1, hard: -1 }
    mem_limit: ${MEM_LIMIT_ES}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:9200/_cluster/health | grep -qE '\"status\":\"(green|yellow)\"'"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 90s
    logging: *default-logging

  # ----------------------------------------------------------------
  # ONLYOFFICE DocumentServer — edição colaborativa online
  # (equivalente a Word / Excel / PowerPoint Online do Office 365)
  # ----------------------------------------------------------------
  onlyoffice:
    image: ${ONLYOFFICE_IMAGE}
    container_name: onlyoffice
    environment:
      TZ: ${TZ}
      JWT_ENABLED: "true"
      JWT_SECRET: ${ONLYOFFICE_JWT_SECRET}
      SECURE_LINK_SECRET: ${ONLYOFFICE_SECURE_LINK_SECRET}
      ALLOW_PRIVATE_IP_ADDRESS: "true"
      ALLOW_META_IP_ADDRESS: "true"
    volumes:
      - ./data/onlyoffice/data:/var/www/onlyoffice/Data
      - ./data/onlyoffice/log:/var/log/onlyoffice
      - ./data/onlyoffice/cache:/var/lib/onlyoffice/documentserver/App_Data/cache/files
    mem_limit: ${MEM_LIMIT_ONLYOFFICE}
    healthcheck:
      # O teste passa PRIMEIRO direto no DocService (porta 8000) e só depois
      # pelo nginx interno (porta 80). A ordem não é estética:
      #   o nginx do ONLYOFFICE sobe em segundos, o DocService leva ~1 min.
      #   Sondar /healthcheck pelo nginx nesse intervalo faz o próprio nginx
      #   registrar, no log do container:
      #     [error] connect() failed (111: Connection refused) while connecting
      #             to upstream, request: "GET /healthcheck HTTP/1.1"
      #   `start_period` não evita isso: ele só impede que a falha CONTE
      #   contra a saúde do container — a sondagem continua sendo executada,
      #   e o erro continua sendo gravado.
      # Verificar antes se há upstream vivo elimina a causa (pedir ao proxy
      # algo que ele ainda não tem como servir), e não o sintoma. O teste
      # segue sendo real: só reporta saudável quando /healthcheck responde
      # `true` através do nginx, que é o caminho que o eXo de fato usa.
      # NOTA sobre a 1a sonda: é `curl -sS` SEM `-f`, de propósito. O que se
      # quer saber dela é só "há alguém escutando na 8000", e a raiz do
      # DocService responde 404 (não tem rota "/"). Com `-f` o curl trata 404
      # como falha e o container nunca ficaria saudável — testado. Sem `-f`,
      # o comando só falha quando a conexão é RECUSADA (curl exit 7), que é
      # exatamente a condição que se quer detectar. A verificação de verdade
      # é a 2a, através do nginx, e essa continua com `-f`.
      test: ["CMD-SHELL", "curl -sS -o /dev/null http://localhost:8000/ && curl -fsS http://localhost/healthcheck | grep -q true"]
      interval: 30s
      timeout: 10s
      retries: 20
      start_period: 120s
    logging: *default-logging

  # ----------------------------------------------------------------
  # Mailpit — servidor SMTP de captura + webmail de inspeção
  # Permite PROVAR que convites, notificações e reset de senha saem.
  # Para SMTP real: alterar EXO_MAIL_SMTP_* no .env e recriar o serviço exo.
  # ----------------------------------------------------------------
  mailpit:
    image: ${MAILPIT_IMAGE}
    container_name: exo-mailpit
    environment:
      TZ: ${TZ}
      MP_MAX_MESSAGES: 5000
      MP_SMTP_AUTH_ACCEPT_ANY: 1
      MP_SMTP_AUTH_ALLOW_INSECURE: 1
    ports:
      - "${MAILPIT_UI_PORT:-8025}:8025"
    volumes:
      - ./data/mailpit:/data
    mem_limit: 128m
    healthcheck:
      test: ["CMD", "/mailpit", "readyz"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging: *default-logging

  # ----------------------------------------------------------------
  # Matrix / Synapse — servidor de chat (equivalente ao Teams)
  # NÃO faz parte do docker-compose.yml oficial do eXo. Foi acrescentado
  # porque na linha 7.x o eXo substituiu o chat nativo pela integração
  # com o protocolo Matrix: sem um homeserver, o chat simplesmente não
  # existe e o boot ainda perde ~5 min em 20 tentativas de conexão.
  # Parâmetros de integração conforme github.com/Meeds-io/matrix
  # ----------------------------------------------------------------
  synapse-db:
    image: ${SYNAPSE_DB_IMAGE}
    container_name: exo-synapse-db
    environment:
      POSTGRES_DB: synapse
      POSTGRES_USER: synapse
      POSTGRES_PASSWORD: ${MATRIX_DB_PASSWORD}
      # Synapse EXIGE estas opções de collation; sem elas recusa iniciar.
      # --auth-local/--auth-host evitam o aviso do initdb:
      #   'initdb: warning: enabling "trust" authentication for local connections'
      # (o padrão da imagem é 'trust', que dispensa senha no socket local).
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --lc-collate=C --lc-ctype=C --auth-local=scram-sha-256 --auth-host=scram-sha-256"
      POSTGRES_HOST_AUTH_METHOD: scram-sha-256
      TZ: ${TZ}
    volumes:
      - ./data/synapse-db:/var/lib/postgresql/data
    mem_limit: ${MEM_LIMIT_SYNAPSE_DB}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U synapse -d synapse"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 30s
    logging: *default-logging

  synapse:
    image: ${SYNAPSE_IMAGE}
    container_name: exo-synapse
    environment:
      SYNAPSE_SERVER_NAME: ${MATRIX_SERVER_NAME}
      SYNAPSE_REPORT_STATS: "no"
      SYNAPSE_CONFIG_DIR: /data
      SYNAPSE_CONFIG_PATH: /data/homeserver.yaml
      TZ: ${TZ}
    volumes:
      - ./data/synapse:/data
    depends_on:
      synapse-db:
        condition: service_healthy
    mem_limit: ${MEM_LIMIT_SYNAPSE}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:8008/health || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 20
      start_period: 60s
    logging: *default-logging

networks:
  default:
    name: exo_net
