<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registro do conector DLP por padrao no processador do add-on exo-dlp.

  COMO ISTO ENTRA EM VIGOR
  ===
  O kernel da eXo le conf/portal/configuration.xml de TODO jar do classpath.
  Este arquivo acrescenta um plugin ao DlpOperationProcessor com o mesmo
  set-method que o add-on usa (addConnector).

  O mapa de conectores e' indexado por TIPO. Como este conector declara
  type=file ; o mesmo tipo com que FileDLPAction enfileira os itens =, ele
  ocupa a mesma posicao do conector nativo. Isso e' intencional: conector de
  tipo novo nao receberia item algum, porque nada enfileira outro tipo.

  MODO DE FALHAR: se por ordem de carga este registro NAO prevalecer, o
  conector nativo permanece e o DLP funciona exatamente como antes desta
  extensao. Nunca pior. A prova de que prevaleceu esta' no log do boot:
  "DLP por padrao: ligado=... severidadeMinima=... acao=..."
-->
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
    xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">

  <external-component-plugins>
    <target-component>org.exoplatform.dlp.processor.DlpOperationProcessor</target-component>
    <component-plugin>
      <name>ConectorDlpRegex</name>
      <set-method>addConnector</set-method>
      <type>br.pmo.dlp.exo.ConectorDlpRegex</type>
      <description>DLP por padrao: CPF, CNPJ, cartao, PIS, titulo, CNH, chave PIX e segredo em texto claro, com digito verificador</description>
      <!-- PRIORIDADE: o kernel ordena os plugins de um mesmo alvo por este
           numero antes de invocar o set-method. O conector nativo nao declara
           prioridade (0), entao a prioridade daqui decide quem chega primeiro.

           CORRIGIDO 2026-08-31  ;  ERA 100, E ISSO INVERTIA O EFEITO.
           A premissa anterior ("quem e' aplicado por ULTIMO fica com a chave
           file") esta errada nos dois pontos, e as duas coisas foram lidas no
           bytecode do add-on, nao supostas:

             1. ComponentPlugin.compareTo devolve
                  this.getPriority() - other.getPriority()
                ou seja, ordenacao ASCENDENTE: prioridade MENOR e' aplicada
                ANTES. Com 100, este conector era o ULTIMO.

             2. DlpOperationProcessor.addConnector(c) chama
                  addConnector(c, Boolean.FALSE)
                e o corpo e'
                  if (connectors.containsKey(c.getType()) && !override)
                      LOGGER.error("Impossible to add connector {} ...");
                  else
                      connectors.put(c.getType(), c);
                Isto e' FIRST-WINS: quem chega primeiro fica, e o segundo e'
                DESCARTADO com ERROR  ;  nao sobrescreve.

           Somando as duas: com prioridade 100 o conector nativo registrava a
           chave "file" primeiro e ESTE conector era jogado fora a cada boot,
           deixando no log exatamente a linha
             ERROR | Impossible to add connector file. A connector with the
                     same name has already been registered.
           O log "DLP por padrao: ligado=true ..." logo acima dela vem do
           CONSTRUTOR desta classe, que roda mesmo quando o objeto e'
           descartado  ;  por isso a deteccao brasileira (CPF, CNPJ, cartao,
           PIS, titulo, CNH, chave PIX) parecia ligada e nao estava.

           Com prioridade negativa este conector chega primeiro e fica. Nada se
           perde ao deslocar o nativo: ConectorDlpRegex EXTENDS
           FileDlpConnector e chama super(...) no construtor, entao e'
           superconjunto estrito  ;  o comportamento de palavras-chave nativo
           continua valendo, por heranca. -->
      <priority>-100</priority>
      <init-params>
        <!-- Palavras-chave nativas: repassadas ao comportamento herdado. -->
        <value-param>
          <name>dlp.keywords</name>
          <value>${exo.dlp.keywords:}</value>
        </value-param>

        <!-- Liga/desliga so' a deteccao por padrao. Desligado, o conector se
             comporta exatamente como o nativo. -->
        <value-param>
          <name>dlp.regex.enabled</name>
          <value>${exo.dlp.regex.enabled:true}</value>
        </value-param>

        <!-- Corte de severidade. ALTA = so' o que tem digito verificador
             conferido. Baixar para BAIXA faria e-mail e telefone contarem, o
             que em documento administrativo e' praticamente todo arquivo. -->
        <value-param>
          <name>dlp.regex.severidadeMinima</name>
          <value>${exo.dlp.regex.severidadeMinima:ALTA}</value>
        </value-param>

        <!-- ACAO. Nasce em ALERTAR de proposito: quarentena automatica por
             padrao, num acervo em producao que nunca foi medido, retiraria
             documento legitimo de circulacao em massa. Primeiro se le o laudo
             no log, depois se endurece para QUARENTENAR. -->
        <value-param>
          <name>dlp.regex.acao</name>
          <value>${exo.dlp.regex.acao:ALERTAR}</value>
        </value-param>

        <!-- ACAO PARA VARREDURA INCOMPLETA. Documento que o motor nao
             conseguiu abrir por inteiro (acima do teto, sem binario, ou PDF
             digitalizado sem camada de texto) NAO e' documento limpo. Antes
             desta chave existir, esses casos saiam do motor com laudo
             "completo e limpo" e um PDF escaneado passava por PUBLICO.

             Nasce em REGISTRAR: num acervo com muita digitalizacao, ALERTAR
             de saida produz enxurrada no primeiro job, e alerta em massa e'
             alerta que se aprende a ignorar. Mede-se o volume, sobe-se para
             ALERTAR depois. O que nao pode e' voltar a ser tratado como limpo. -->
        <value-param>
          <name>dlp.regex.acaoQuandoIncompleta</name>
          <value>${exo.dlp.regex.acaoQuandoIncompleta:REGISTRAR}</value>
        </value-param>

        <value-param>
          <name>dlp.regex.minimoOcorrencias</name>
          <value>${exo.dlp.regex.minimoOcorrencias:1}</value>
        </value-param>

        <!-- Teto de bytes por arquivo na extracao. Acima disso varre-se so'
             nome e titulo: extrair um binario gigante ameaca um heap que ja'
             opera perto do limite. -->
        <value-param>
          <name>dlp.regex.tetoBytesArquivo</name>
          <value>${exo.dlp.regex.tetoBytesArquivo:16777216}</value>
        </value-param>

        <properties-param>
          <name>constructor.params</name>
          <property name="enable" value="true"/>
          <property name="displayName" value="file"/>
          <property name="type" value="file"/>
        </properties-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  <!--
    Enfileiramento proprio para a varredura por padrao.

    A acao oficial FileDLPAction so' enfileira quando ha' palavra-chave
    cadastrada. Deteccao por padrao nao pode depender disso: um CPF e' um CPF
    independentemente de alguem ter digitado alguma palavra numa tela.

    Este plugin e' ACRESCENTADO com nome proprio; o plugin "addActions" do
    add-on continua registrado e continua valendo. As duas acoes convivem.

    A acao so' enfileira de fato se o conector de padrao estiver registrado ;
    ver as travas em AcaoEnfileirarDlp.
  -->
  <external-component-plugins>
    <target-component>org.exoplatform.services.jcr.impl.ext.action.SessionActionCatalog</target-component>
    <component-plugin>
      <name>acoesDlpPadrao</name>
      <set-method>addPlugin</set-method>
      <type>org.exoplatform.services.jcr.impl.ext.action.AddActionsPlugin</type>
      <description>Enfileira arquivos para a varredura DLP por padrao</description>
      <init-params>
        <object-param>
          <name>actions</name>
          <object type="org.exoplatform.services.jcr.impl.ext.action.AddActionsPlugin$ActionsConfig">
            <field name="actions">
              <collection type="java.util.ArrayList">
                <value>
                  <object type="org.exoplatform.services.jcr.impl.ext.action.ActionConfiguration">
                    <field name="workspace"><string>collaboration</string></field>
                    <field name="eventTypes"><string>addNode,addProperty,changeProperty</string></field>
                    <field name="nodeTypes"><string>nt:file,nt:resource</string></field>
                    <field name="path"><string>/</string></field>
                    <field name="isDeep"><boolean>true</boolean></field>
                    <field name="actionClassName"><string>br.pmo.dlp.exo.AcaoEnfileirarDlp</string></field>
                  </object>
                </value>
              </collection>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

</configuration>
