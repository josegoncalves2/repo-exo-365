<?xml version="1.0" encoding="UTF-8"?>
<!--
  A pagina que o no' de menu aponta.

  As permissoes sao as mesmas que a plataforma usa nas paginas de administracao
  desta imagem (membershipsManagement e transferRules): ver exige pertencer a
  /platform/administrators, editar o layout exige ser gerente do grupo.

  Esta e' a PRIMEIRA das duas camadas de controle de acesso. A segunda esta' no
  proprio portlet, que confere a associacao ao grupo a cada render e a cada
  acao. A primeira e' declarativa e pode ser alterada pela interface do portal;
  a segunda nao.
-->
<page-set
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.gatein.org/xml/ns/gatein_objects_1_14 http://www.gatein.org/xml/ns/gatein_objects_1_14"
  xmlns="http://www.gatein.org/xml/ns/gatein_objects_1_14">
  <page>
    <name>conformidade-dlp</name>
    <title>Conformidade DLP</title>
    <access-permissions>*:/platform/administrators</access-permissions>
    <edit-permission>manager:/platform/administrators</edit-permission>
    <show-max-window>false</show-max-window>
    <container id="singlePageApplicationContainer"
               template="system:/groovy/portal/webui/container/UIContainer.gtmpl"
               cssClass="singlePageApplication">
      <access-permissions>*:/platform/administrators</access-permissions>
      <portlet-application>
        <portlet>
          <application-ref>pmo-painel</application-ref>
          <portlet-ref>conformidadeDlp</portlet-ref>
        </portlet>
        <title>Conformidade DLP</title>
        <access-permissions>*:/platform/administrators</access-permissions>
        <show-info-bar>false</show-info-bar>
        <show-application-state>false</show-application-state>
      </portlet-application>
    </container>
  </page>
</page-set>
