<?xml version="1.0" encoding="UTF-8"?>
<!--
  UM no', pendurado num galho que ja' existe.

  parent-uri e' o mecanismo que permite acrescentar sem redeclarar a arvore
  inteira. Redeclarar home / security aqui faria esta extensao virar dona de um
  menu que nao e' dela, e no dia em que a plataforma acrescentasse um no' de
  seguranca proprio, os dois arquivos brigariam.

  O caminho aninhado home/security e' aceito: a propria plataforma usa
  parent-uri aninhado nesta imagem (home/apps e home/more, no digital-workplace).
  O ai-agent usa a mesma tecnica para pendurar os nos dele em home.

  O rotulo NAO esta' escrito aqui. Ele vem de
  locale/navigation/portal/administration_pt_BR.properties, que a plataforma
  funde entre todos os WAR: cada extensao contribui so' com as suas chaves.
-->
<node-navigation
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.gatein.org/xml/ns/gatein_objects_1_14 http://www.gatein.org/xml/ns/gatein_objects_1_14"
  xmlns="http://www.gatein.org/xml/ns/gatein_objects_1_14">
  <priority>7</priority>
  <page-nodes>
    <parent-uri>home/security</parent-uri>
    <node>
      <name>conformidade-dlp</name>
      <label>#{portal.administration.conformidade-dlp}</label>
      <icon>fas fa-user-shield</icon>
      <page-reference>portal::administration::conformidade-dlp</page-reference>
    </node>
  </page-nodes>
</node-navigation>
