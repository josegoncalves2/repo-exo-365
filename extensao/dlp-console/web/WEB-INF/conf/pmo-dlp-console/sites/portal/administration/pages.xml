<?xml version="1.0" encoding="UTF-8"?>
<!--
  A pagina `dlp-quarantine` — que JA' EXISTE e e' apontada pelo no' de menu
  `security/quarantine` de digital-workplace.war.

  POR QUE ESTA EXTENSAO REDECLARA UMA PAGINA QUE NAO E' DELA. O pedido foi
  levar o aparato de DLP para dentro do menu que ja' existe, em vez de abrir um
  segundo menu para o mesmo assunto. O no', o rotulo e o `page-reference`
  continuam sendo da plataforma; muda apenas o CONTEUDO da pagina.

  O que ESTA declaracao muda em relacao a' da plataforma: onde antes havia o
  portlet `dlp/dlpQuarantine` sozinho, agora ha' `pmo-dlp-console/consoleDlp`,
  cujo cofre mostra os DOIS acervos lado a lado — o deste motor e o do add-on
  nativo, lido pela REST da propria eXo em /rest/dlp/items. Nada e' apagado: o
  WAR `dlp` continua instalado, o portlet `dlpQuarantine` continua registrado e
  pode ser recolocado em qualquer pagina pelo editor do portal.

  As permissoes sao as MESMAS da declaracao original em digital-workplace.war,
  conferidas no container: acesso a `Everyone` no contentor e no portlet, e a
  pagina restrita a `*:/platform/administrators`. A segunda camada de controle
  esta' no REST, que exige participacao no grupo a cada chamada.

  IMPORTA: o importador roda com `importMode=merge`, e este pacote declara UMA
  pagina. Merge atualiza o que esta' declarado e nao toca no que nao esta',
  entao as demais paginas de administracao da eXo seguem intactas. `overwrite`
  faria o oposto e derrubaria o menu inteiro.
-->
<page-set
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.gatein.org/xml/ns/gatein_objects_1_14 http://www.gatein.org/xml/ns/gatein_objects_1_14"
  xmlns="http://www.gatein.org/xml/ns/gatein_objects_1_14">
  <page>
    <name>dlp-quarantine</name>
    <title>Data Loss Prevention</title>
    <access-permissions>*:/platform/administrators</access-permissions>
    <edit-permission>manager:/platform/administrators</edit-permission>
    <show-max-window>false</show-max-window>
    <container id="singlePageApplicationContainer"
               template="system:/groovy/portal/webui/container/UIContainer.gtmpl"
               cssClass="singlePageApplication">
      <access-permissions>Everyone</access-permissions>
      <portlet-application>
        <portlet>
          <application-ref>pmo-dlp-console</application-ref>
          <portlet-ref>consoleDlp</portlet-ref>
        </portlet>
        <title>Data Loss Prevention</title>
        <access-permissions>Everyone</access-permissions>
        <show-info-bar>false</show-info-bar>
        <show-application-state>false</show-application-state>
      </portlet-application>
    </container>
  </page>
</page-set>
