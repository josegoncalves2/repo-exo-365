<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Registro de recursos no padrao da plataforma.

  ESTE ARQUIVO NAO EXISTIA ate' 2026-09-01, e a sua ausencia era a causa de o
  console nao se parecer com o portal: sem `portlet-skin`, o portlet nao herda
  a folha de estilo `Enterprise`, e a tela era obrigada a trazer a propria CSS
  embutida. Era exatamente a "webpagina" apontada pelo operador.

  A forma abaixo e' COPIA da que o add-on nativo usa em
  /opt/exo/webapps/dlp/WEB-INF/gatein-resources.xml (dlpQuarantine), conferida
  no container. Os `depends` importam:
    vue / vuetify        -> Vue 2 e Vuetify 2.3.10, que a plataforma ja' serve;
                            declarar aqui evita embarcar copia propria.
    eXoVueI18n           -> `exoi18n.loadLanguageAsync`, o carregador de bundle
                            que o portal usa; sem ele o console teria rotulo
                            fixo em portugues no codigo.
    commonVueComponents  -> os componentes compartilhados da eXo.
    extensionRegistry    -> permite que OUTRA extensao acrescente secoes a este
                            console sem tocar neste WAR — a mesma porta que o
                            dlpQuarantine nativo abre com "dlp-quarantine-app".
-->
<gatein-resources
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/gatein_resources_1_4 http://www.exoplatform.org/xml/ns/gatein_resources_1_4"
  xmlns="http://www.exoplatform.org/xml/ns/gatein_resources_1_4">

  <portlet-skin>
    <application-name>pmo-dlp-console</application-name>
    <portlet-name>consoleDlp</portlet-name>
    <skin-name>Enterprise</skin-name>
    <css-path>/skin/css/console-dlp.css</css-path>
  </portlet-skin>

  <portlet>
    <name>consoleDlp</name>
    <module>
      <script>
        <minify>false</minify>
        <path>/js/consoleDlp.bundle.js</path>
      </script>
      <depends>
        <module>vue</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>vuetify</module>
      </depends>
      <depends>
        <module>commonVueComponents</module>
      </depends>
      <depends>
        <module>extensionRegistry</module>
      </depends>
    </module>
  </portlet>

</gatein-resources>
