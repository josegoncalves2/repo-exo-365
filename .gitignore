# ===================================================================
# NUNCA versionar segredos.
# O .env e o conf/exo.properties contêm senhas de banco, segredo de
# registro do Matrix e chaves JWT em texto claro. São gerados por
# scripts/gerar-segredos.sh e scripts/setup-matrix.sh a cada instalação.
# ===================================================================
.env
.env.bak-*
.env.local
conf/exo.properties

# Ambiente virtual da suíte de testes (157 MB de binários; recriável
# com scripts/preparar-testes.sh)
tests/.venv/
__pycache__/
*.pyc

# Dados de execução que não descrevem o projeto
conf/synapse/
*.pid

# Banco de dados
/data

# Chaves privadas do MySQL (PKI de 2 níveis gerada em cada instalação).
# A chave da CA intermediária permite emitir certificados novos confiáveis
# para esta cadeia — não pode ser versionada. Tudo é regenerável com
# scripts/gerar-certificados-mysql.sh.
conf/mysql-certs/

# Backups locais (dumps de banco, tarballs de dados, cópias de config)
backup/
