# ===================================================================
# eXo Platform Community 7.2.1 — propriedades da aplicação
# Montado em /etc/exo/exo.properties (somente leitura)
#
# Este arquivo complementa as variáveis EXO_* do docker-compose.
# Referência: https://docs.exoplatform.org/administration/configuration.html
#
# ATENÇÃO: não repetir aqui chaves já definidas via variáveis EXO_*
# (banco, ES, SMTP, JVM) — o entrypoint do container as escreve
# neste mesmo arquivo e duplicatas geram conflito.
# ===================================================================

# -------------------------------------------------------------------
# Identidade da instância
# -------------------------------------------------------------------
exo.portal.name=PMO eXo
exo.company.name=PMO

# -------------------------------------------------------------------
# Registro e acesso de usuários
# Substituição do Office 365 em rede interna: cadastro controlado
# pelo administrador, sem auto-registro público.
# -------------------------------------------------------------------
exo.public.registration.enabled=false
exo.portal.resetpassword.expiretime=24

# -------------------------------------------------------------------
# Notificações (dependem do SMTP configurado via EXO_MAIL_SMTP_*)
# -------------------------------------------------------------------
exo.notification.portalname=PMO eXo
exo.notification.service.QueueMessage.period=60
exo.notification.service.QueueMessage.numberOfMailPerBatch=30

# -------------------------------------------------------------------
# Documentos / Drive — equivalente ao OneDrive + SharePoint
# -------------------------------------------------------------------
# Extensões bloqueadas por segurança no upload
exo.ecms.connector.drives.uploadLimit=500

# -------------------------------------------------------------------
# ONLYOFFICE — edição colaborativa (Word/Excel/PowerPoint online)
# O host/schema/secret vêm de JAVA_OPTS no docker-compose.
# Aqui ficam apenas os ajustes de comportamento.
# -------------------------------------------------------------------
onlyoffice.editor.forcesavetimeout=5000

# -------------------------------------------------------------------
# Busca unificada
# -------------------------------------------------------------------
exo.es.search.connection.timeout=60000
exo.unified-search.engine.max-result=50

# -------------------------------------------------------------------
# Agenda / Calendário — equivalente ao Outlook Calendar
# Semana começando na segunda, formato brasileiro
# -------------------------------------------------------------------
exo.agenda.week.firstDay=MO

# -------------------------------------------------------------------
# Chat — equivalente ao Microsoft Teams (mensageria)
# -------------------------------------------------------------------
exo.chat.notification.enabled=true

# -------------------------------------------------------------------
# Auditoria / observabilidade
# -------------------------------------------------------------------
exo.audit.enabled=true

# -------------------------------------------------------------------
# Matrix / Synapse — chat
# O bloco meeds.matrix.* NAO fica neste modelo porque contem segredos.
# Ele e escrito automaticamente por scripts/setup-matrix.sh, que le os
# valores do .env. Nao preencher a mao.
# -------------------------------------------------------------------

# --- Videoconferencia (Web Conferencing + External Visio) — AUDIT [101] ---
# Torna EXPLICITA a ativacao do provedor, que a imagem traz como padrao
# implicito (${webconferencing.externalVisio.active:true} em
# external-visio/WEB-INF/conf/externalvisio/configuration.xml). Assim uma
# futura mudanca do default do fabricante nao desliga a videoconferencia
# silenciosamente. Quem serve a chamada e' o Jitsi auto-hospedado desta
# stack (servicos jitsi-* do docker-compose.yml), em https://<host>:8443.
webconferencing.externalVisio.active=true

# ---------------------------------------------------------------------------
# ADDON OFICIAL eXo Jitsi 7.2.1 (org.exoplatform.addons.jitsi:exo-jitsi)
#
# Sem este bloco NAO existe ligacao (toque + atender/recusar): o External
# Visio acima apenas abre a URL de uma sala. O addon implementa o provider da
# SPI WebConferencingService e depende do microservico jitsi-call, que assina
# o JWT da sala ja' com o nome do usuario -- e' o que dispensa "digite seu
# nome" e o lobby.
#
# ATENCAO aos pares que TEM de bater, ou o portal leva 401 do microservico:
#   webconferencing.jitsi.external.secret  ==  JITSI_EXO_JWT_SECRET (.env)
#   webconferencing.jitsi.internal.secret  ==  JITSI_INTERNAL_SECRET (.env)
# scripts/gerar-segredos.sh preenche os dois arquivos com o MESMO valor.
#
# Os defaults do addon sao publicos (estao no fonte no GitHub) -- nunca use.
# ---------------------------------------------------------------------------
webconferencing.jitsi.active=true
webconferencing.jitsi.url=http://jitsi-call
webconferencing.jitsi.internal.secret=__JITSI_INTERNAL_SECRET__
webconferencing.jitsi.external.secret=__JITSI_EXO_JWT_SECRET__

# ---------------------------------------------------------------------------
# AGENDA: provedor de videoconferencia padrao
# Sem isto, o formulario de evento so' oferece "Insira um link para a chamada
# do evento" (colar URL a mao). Com o provedor definido, ao escolher a agenda
# do espaco aparece o botao "Criar conferencia", que gera a sala e o convite:
#   TYPE=jitsi  URL=https://<host>/jitsi/meet/g_<space>-<uuid>?inviteId=<token>
# Valor = o 'type' do provider no WebConferencingService (getProvidersConfig).
# ---------------------------------------------------------------------------
exo.agenda.webConferencing.default=jitsi

# ===================================================================
# ADD-ONS OFICIAIS — instalados em 2026-08-26
# Lista, versão e sha256 em conf/addons/manifesto.json (fonte única).
#
# REGRA DESTE BLOCO: só entra aqui propriedade que ALGUÉM LÊ. Cada chave
# abaixo foi confirmada como placeholder ${chave} dentro do .war/.jar do
# próprio add-on, e o valor padrão citado é o que o add-on declara.
# O motivo da regra está logo abaixo, no bloco do GLPI.
# ===================================================================

# -------------------------------------------------------------------
# DLP — Proteção contra Vazamento de Dados (exo-dlp 7.2.1, AGPLv3)
# Lê: dlp.war!WEB-INF/conf/dlp/connector-configuration.xml
#     dlp-services.jar!conf/portal/configuration.xml
#
# Como funciona: um job varre o conteúdo indexado e põe em QUARENTENA o
# documento que casar com uma das palavras-chave. Documento em quarentena
# sai da busca e do espaço, e só o administrador o vê.
#
# POR QUE NASCE SEM PALAVRA-CHAVE: lista vazia = nada é posto em quarentena.
# Ligar DLP com um chute de palavras num acervo já em produção tiraria do ar
# documentos legítimos de servidores que não foram avisados. A lista é decisão
# da administração, não do instalador. Para ligar, preencha (separado por
# vírgula) e reinicie o exo-app. Sugestão de partida, comentada:
#   exo.dlp.keywords=confidencial,sigiloso,uso interno,senha,CPF,dados bancarios
# -------------------------------------------------------------------
exo.dlp.keywords=
exo.dlp.job.period=300000

# -------------------------------------------------------------------
# 2FA por grupo (exo-multifactor-authentication 7.2.1 + mfa-fido + mfa-oidc)
# Lê: multifactor-authentication.war!WEB-INF/conf/multifactor-authentication/
#     mfa-configuration.xml
#
# "2FA POR ZONA", na prática desta plataforma, é 2FA POR GRUPO e POR ÁREA DE
# NAVEGAÇÃO: exo.mfa.protectedGroups exige o segundo fator de quem pertence
# aos grupos listados, e exo.mfa.protectedGroupNavigations o exige para entrar
# em determinadas áreas do portal. Não existe "zona" por faixa de IP no
# add-on — quem precisa disso resolve na borda (nginx), não aqui.
#
# Segundo fator: OTP (app autenticador, sem dependência externa) é o padrão.
#   OTP  — Google Authenticator / FreeOTP / Aegis. Não depende de rede externa.
#   FIDO — chave física; exige servidor FIDO (exo.mfa.fido.serverUrl).
#   OIDC — provedor externo (exo.mfa.oidc.oidcServer + clientId).
#
# POR QUE NASCE SEM GRUPO PROTEGIDO: ligar 2FA em /platform/administrators
# antes de os administradores terem cadastrado o app autenticador TRANCA o
# portal — quem tem a chave para reverter é justamente quem ficou de fora.
# A ordem correta é: administradores cadastram o segundo fator, e SÓ ENTÃO o
# grupo entra aqui. Para ligar depois de cadastrado:
#   exo.mfa.protectedGroups=/platform/administrators
# -------------------------------------------------------------------
exo.mfa.system=OTP
exo.mfa.protectedGroups=
exo.mfa.protectedGroupNavigations=
exo.mfa.otp.issuer=PMO eXo
exo.mfa.otp.algorithm=SHA1
exo.mfa.otp.codedigits=6
exo.mfa.otp.timeperiod=30

# -------------------------------------------------------------------
# Anti-força-bruta (exo-anti-bruteforce 7.2.1)
# Lê: anti-bruteforce.war!WEB-INF/conf/antibruteforce/plugin-configuration.xml
# Os valores abaixo SÃO os padrões do add-on. Estão escritos, e não omitidos,
# porque política de bloqueio de conta é coisa que auditoria pergunta — tem de
# estar visível num arquivo, não escondida num default dentro de um .war.
# blockingTime é em MINUTOS.
# -------------------------------------------------------------------
exo.authentication.antibruteforce.maxAuthenticationAttempts=5
exo.authentication.antibruteforce.blockingTime=10

# -------------------------------------------------------------------
# Antimalware (exo-anti-malware 7.2.1)
# Varre o que é enviado ao portal. O conector padrão (Trend Micro) é um
# serviço externo e fica DESLIGADO: sem contrato, ligá-lo faria cada upload
# tentar uma chamada que nunca responde.
# Período do job de varredura, em milissegundos.
# -------------------------------------------------------------------
exo.antiMalware.MalwareDetectionJob.period=300000
exo.malwareDetection.connector.trendMicro.isDefault=false

# -------------------------------------------------------------------
# ASSISTENTE DE IA (meeds-ai 7.2.1-exo, LGPLv3)
# https://www.exoplatform.com/faq/#ai-responsible-ai
# Lê: ai-common.jar → ${meeds.ai.agent.enabled:false}
#
# DECISÃO DO OPERADOR, 2026-08-25, registrada aqui porque é permanente:
#   NENHUM LLM LOCAL, EM HIPÓTESE ALGUMA.
# Não há, e não haverá, container Ollama nesta stack. O add-on suporta Ollama
# local, e essa opção está descartada por decisão — não por limitação.
#
# O provedor (Anthropic, OpenAI, Mistral, xAI) e a respectiva chave NÃO são
# propriedades: o add-on os guarda no banco e eles são preenchidos na tela de
# administração. Por isso não existe chave de API neste arquivo, e não deve
# passar a existir.
#
# Fica INSTALADO E DESLIGADO. Ligar exige, nesta ordem: (1) decisão da
# prefeitura sobre enviar conteúdo do portal a um provedor externo — é dado de
# servidor público, a pergunta é de LGPD antes de ser técnica; (2) provedor e
# chave cadastrados na tela; (3) esta chave em true e reinício do exo-app.
#
# RAG: o índice vetorial usa o Elasticsearch que a stack já tem
# (spring.ai.vectorstore.type=elasticsearch, padrão do add-on) — sem serviço
# novo. As ferramentas MCP usam o mcp-server e o auth-server que já vêm na
# imagem.
# -------------------------------------------------------------------
meeds.ai.agent.enabled=false

# -------------------------------------------------------------------
# Tradução automática (exo-automatic-translation 7.2.1)
# Também depende de provedor externo, também desligado pelo mesmo motivo
# do bloco acima. A URL abaixo só é lida se um provedor for cadastrado.
# -------------------------------------------------------------------
# exo.automatic-translation.language-weaver.url=

# -------------------------------------------------------------------
# Conectores de agenda externa (exo-agenda-connectors 7.2.1)
# Substituem o calendário do 365. Cada um exige credencial de aplicativo
# registrada no provedor — sem isso, ligá-los só produz erro de OAuth.
# -------------------------------------------------------------------
exo.agenda.exchange.connector.enabled=false
exo.agenda.google.connector.enabled=false
exo.agenda.office.connector.enabled=false

# -------------------------------------------------------------------
# Caixa de e-mail no portal (exo-mail-integration 7.2.1)
# Desligada até haver servidor IMAP definido para os usuários.
# -------------------------------------------------------------------
exo.feature.mailIntegration.enabled=false
