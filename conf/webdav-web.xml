<web-app
  version="3.0"
  metadata-complete="true"
  xmlns="http://java.sun.com/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">

  <display-name>webdav</display-name>
  <absolute-ordering />

  <listener>
    <listener-class>org.exoplatform.container.web.PortalContainerConfigOwner</listener-class>
  </listener>

  <listener>
    <listener-class>org.exoplatform.services.security.web.ConversationStateListener</listener-class>
  </listener>

  <!-- ===================================================================
       ACRESCENTADO 2026-08-27 ; FECHA UM DESVIO DE 2FA E DE POLITICA
       DE TRANSFERENCIA.

       O webapp `portal` declara org.exoplatform.web.filter.GenericFilter,
       que e' quem executa a cadeia do ExtensibleFilter ; e' por ela que as
       extensoes proprias (2FA por zona, restricoes de transferencia) sao
       chamadas. Este webapp NAO a declarava.

       Consequencia medida: o nginx tem um `location /` que encaminha tudo,
       entao /webdav/... chega aqui, e aqui os filtros nunca rodavam. Um
       usuario sob exigencia de segundo fator montava o acervo como unidade
       de rede e lia e gravava documento SEM o segundo fator, e sem passar
       por nenhuma regra de download. Exigencia na navegacao e porta aberta
       ao lado nao e' controle ; e' a aparencia de controle.

       O caminho apontado por revisao cruzada da sessao paralela: "se a
       exigencia vale para a navegacao mas o WebDAV monta o acervo como
       unidade de rede, e' o mesmo padrao do REST isento por outra porta".
       Estava certo.
       =================================================================== -->
  <filter>
    <filter-name>GenericFilter</filter-name>
    <filter-class>org.exoplatform.web.filter.GenericFilter</filter-class>
  </filter>

  <filter>
    <filter-name>SetCurrentIdentityFilter</filter-name>
    <filter-class>org.exoplatform.services.security.web.SetCurrentIdentityFilter</filter-class>
    <init-param>
      <param-name>restoreIdentity</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>

  <filter>
    <filter-name>ResourceRequestFilter</filter-name>
    <filter-class>org.exoplatform.portal.application.ResourceRequestFilter</filter-class>
  </filter>

  <!-- ACRESCENTADO 2026-08-27. Cobre TODO o contexto, e nao so' /drives/*:
       o acervo e' alcancado por varios caminhos deste webapp, e um mapeamento
       parcial deixaria exatamente as rotas nao previstas de fora ; que sao as
       que interessam a quem procura desvio. -->
  <filter-mapping>
    <filter-name>GenericFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>ResourceRequestFilter</filter-name>
    <url-pattern>/css/*</url-pattern>
    <url-pattern>/js/*</url-pattern>
    <url-pattern>/html/*</url-pattern>
    <url-pattern>/i18n/*</url-pattern>
    <url-pattern>/images/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>SetCurrentIdentityFilter</filter-name>
    <url-pattern>/drives/*</url-pattern>
  </filter-mapping>

  <security-constraint>
    <web-resource-collection>
      <web-resource-name>rest</web-resource-name>
      <url-pattern>/*</url-pattern>
      <http-method-omission>OPTIONS</http-method-omission>
    </web-resource-collection>
    <auth-constraint>
      <role-name>users</role-name>
    </auth-constraint>
    <user-data-constraint>
      <transport-guarantee>NONE</transport-guarantee>
    </user-data-constraint>
  </security-constraint>

  <!-- ===============================================================
       ACRESCENTADO pelo projeto (nao existe na imagem oficial).

       A restricao acima usa <http-method-omission>OPTIONS</...>, o que
       deixa OPTIONS DE FORA de qualquer security-constraint. O Tomcat 10
       detecta isso e registra, a cada implantacao, em nivel ERROR:

         For security constraints with URL pattern [/*] the HTTP methods
         [OPTIONS] are uncovered.

       A omissao e' intencional (o preflight CORS precisa passar sem
       autenticacao), mas "omitido" e' diferente de "coberto". Este bloco
       COBRE OPTIONS explicitamente e, por NAO declarar <auth-constraint>,
       continua permitindo o metodo sem autenticacao — mesmo comportamento
       de antes, sem o ERROR.
       =============================================================== -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>options-preflight</web-resource-name>
      <url-pattern>/*</url-pattern>
      <http-method>OPTIONS</http-method>
    </web-resource-collection>
    <user-data-constraint>
      <transport-guarantee>NONE</transport-guarantee>
    </user-data-constraint>
  </security-constraint>

  <login-config>
    <auth-method>DIGEST</auth-method>
    <realm-name>webdav-domain</realm-name>
  </login-config>

  <security-role>
    <description>the user role</description>
    <role-name>users</role-name>
  </security-role>

</web-app>
