# ===================================================================
# PERSISTÊNCIA — camada de sobreposição
#
# POR QUE ESTE ARQUIVO EXISTE
# ---------------------------
# Em 2026-08-12 os dados do responsável foram DESTRUÍDOS porque um
# `docker compose down -v` foi executado: a flag -v apaga os volumes
# nomeados. Contas criadas, configurações e conteúdo se perderam e
# NÃO havia backup.
#
# Este arquivo move todo o estado persistente de volumes gerenciados
# pelo Docker para BIND MOUNTS em ./data/, dentro do próprio projeto.
# Consequências práticas:
#
#   * `docker compose down -v` passa a NÃO apagar nada. Bind mounts
#     ficam fora do ciclo de vida de volumes do Docker.
#   * Os dados ficam visíveis no sistema de arquivos, em ./data/,
#     podendo ser copiados, inspecionados e versionados em backup
#     com ferramentas comuns (tar, rsync), sem `docker volume`.
#   * Um `docker system prune --volumes` também não os atinge.
#
# O docker-compose.yml continua BYTE-IDÊNTICO ao upstream
# (sha256 09e37d6cf96a8fcf). O Compose mescla este override
# automaticamente; nada do arquivo oficial foi editado.
#
# Donos dos diretórios (UIDs verificados dentro de cada imagem):
#   mysql -> 999:999      es -> 1000:0      exo -> 999:1001
# ===================================================================

services:

  mysql:
    volumes:
      - ./data/mysql:/var/lib/mysql

  es:
    volumes:
      - ./data/elasticsearch:/usr/share/elasticsearch/data:rw

  exo:
    volumes:
      - ./data/exo:/srv/exo
      # exo_codec guarda as CHAVES DE CRIPTOGRAFIA. Sem elas o banco
      # se torna ilegível: precisa ser copiado JUNTO com ./data/mysql.
      - ./data/exo-codec:/etc/exo/codec:rw
      - ./data/exo-logs:/var/log/exo

  onlyoffice:
    volumes:
      - ./data/onlyoffice/data:/var/www/onlyoffice/Data
      - ./data/onlyoffice/log:/var/log/onlyoffice
