# ===================================================================
# eXo Platform Community 7.2.1 — variaveis de ambiente
# Gerado em: 2026-08-11T14:26:28-03:00
# MODELO versionavel. Gere o .env real com scripts/gerar-segredos.sh
# (este arquivo NAO contem segredos: todos sao placeholders __X__)
# ===================================================================

COMPOSE_PROJECT_NAME=exo

# --- Acesso publico ---
EXO_PROXY_VHOST=__EXO_PROXY_VHOST__
EXO_PROXY_PORT=80
EXO_PROXY_SSL=false
EXO_PROXY_SCHEMA=http
EXO_HTTP_PORT=80

# --- Versoes fixadas (pinadas, sem :latest) ---
EXO_IMAGE=exoplatform/exo-community:7.2.1
MYSQL_IMAGE=mysql:8.4.9
ES_IMAGE=elasticsearch:8.18.8
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.4
NGINX_IMAGE=nginx:1.30.2-alpine
MAILPIT_IMAGE=axllent/mailpit:latest

# --- Banco de dados ---
EXO_DB_NAME=exo
EXO_DB_USER=exo
EXO_DB_PASSWORD=__EXO_DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__

# --- Segredos ---
ONLYOFFICE_JWT_SECRET=__ONLYOFFICE_JWT_SECRET__
ONLYOFFICE_SECURE_LINK_SECRET=__ONLYOFFICE_SECURE_LINK_SECRET__
EXO_REWARDS_WALLET_ADMIN_KEY=__EXO_REWARDS_WALLET_ADMIN_KEY__

# --- Orcamento de memoria (VM: 11961MB / 4 vCPU; ampliada em 2026-08-19) ---
# Teto somado dos containers: 7028m, deixando ~1.2GB livres para o Synapse (chat)
# e ~1.4GB para o SO. NAO aumentar sem checar a RAM FISICA do host Proxmox:
# em 15:43 o host sofreu global_oom e matou esta VM inteira.
# ATUALIZADO em [099]: valores alinhados ao .env real, que passou a incluir
# os 4 containers do Jitsi. O teto do exo subiu de 3072m para 3584m porque a
# medicao mostrou o container a 98,42% do limite (heap G1 ja' commitado em
# 2048m + metaspace 297m), sem folga para memoria nativa/direta.
# Soma dos tetos: 8192m (plataforma) + 1408m (jitsi) = 9600m.
EXO_JVM_SIZE_MIN=512m
EXO_JVM_SIZE_MAX=2048m
EXO_JVM_METASPACE_SIZE_MAX=512m
MEM_LIMIT_EXO=3584m
ES_HEAP=1024m
MEM_LIMIT_ES=1792m
MEM_LIMIT_MYSQL=640m
MEM_LIMIT_ONLYOFFICE=1280m

# --- SMTP (Mailpit interno; trocar por SMTP real aqui) ---
EXO_MAIL_FROM=noreply@exo.local
EXO_MAIL_SMTP_HOST=mailpit
EXO_MAIL_SMTP_PORT=1025
EXO_MAIL_SMTP_STARTTLS=false
EXO_MAIL_SMTP_USERNAME=
EXO_MAIL_SMTP_PASSWORD=
MAILPIT_UI_PORT=8025

# --- Localizacao ---
EXO_JVM_USER_LANGUAGE=pt
EXO_JVM_USER_REGION=BR
TZ=America/Sao_Paulo

# --- Credenciais: a serem definidas PELO RESPONSAVEL na tela de configuracao
#     inicial em http://192.168.1.59/ . Nao serao criadas automaticamente.

# --- Matrix / Synapse (chat — equivalente ao Teams) ---
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.158.0
SYNAPSE_DB_IMAGE=postgres:16-alpine
MATRIX_SERVER_NAME=__MATRIX_SERVER_NAME__
MATRIX_DB_PASSWORD=__MATRIX_DB_PASSWORD__
MATRIX_REGISTRATION_SHARED_SECRET=__MATRIX_REGISTRATION_SHARED_SECRET__
MATRIX_MACAROON_SECRET=__MATRIX_MACAROON_SECRET__
MATRIX_FORM_SECRET=__MATRIX_FORM_SECRET__
MATRIX_JWT_SECRET=__MATRIX_JWT_SECRET__
MATRIX_EXO_USER=exo
MATRIX_EXO_PASSWORD=__MATRIX_EXO_PASSWORD__
MEM_LIMIT_SYNAPSE=300m
MEM_LIMIT_SYNAPSE_DB=200m
MATRIX_SERVER_URL_INTERNAL=http://synapse:8008

# --- Jitsi Meet (videoconferencia — equivalente ao Teams/Skype) ---
# O eXo Community 7.2.1 entrega o framework de videoconferencia e UM conector
# (External Visio), que NAO tem servidor de midia: so' abre uma URL de reuniao.
# O Jitsi entra auto-hospedado nesta mesma stack para que nenhuma chamada
# dependa de terceiros.
# TLS e' OBRIGATORIO: getUserMedia() (camera/microfone) so' funciona em
# contexto seguro; em http:// o navegador bloqueia a captura.
JITSI_IMAGE_WEB=jitsi/web:stable-10008
JITSI_IMAGE_PROSODY=jitsi/prosody:stable-10008
JITSI_IMAGE_JICOFO=jitsi/jicofo:stable-10008
JITSI_IMAGE_JVB=jitsi/jvb:stable-10008
JITSI_HTTPS_PORT=8443
JITSI_JVB_PORT=10000
# IP real da VM: e' o candidato ICE anunciado ao navegador. Se ficar com o IP
# da rede docker (172.x) a chamada conecta e fica SEM VIDEO.
JITSI_JVB_ADVERTISE_IP=__JITSI_JVB_ADVERTISE_IP__
JITSI_XMPP_DOMAIN=meet.jitsi
JITSI_PUBLIC_URL=__JITSI_PUBLIC_URL__
JICOFO_COMPONENT_SECRET=__JICOFO_COMPONENT_SECRET__
JICOFO_AUTH_PASSWORD=__JICOFO_AUTH_PASSWORD__
JVB_AUTH_PASSWORD=__JVB_AUTH_PASSWORD__
# Os padroes da imagem oficial pedem 3 GB de heap por JVM, que NAO cabe nesta
# VM; dimensionado para conferencias pequenas.
JICOFO_MAX_MEMORY=256m
JVB_MAX_MEMORY=512m
MEM_LIMIT_JITSI_WEB=128m
MEM_LIMIT_JITSI_PROSODY=256m
MEM_LIMIT_JICOFO=384m
MEM_LIMIT_JVB=640m

# -------------------------------------------------------------------
# Conta administrativa do portal (AUDIT [113])
# -------------------------------------------------------------------
# ESTAS TRES VARIAVEIS FALTAVAM NESTE MODELO e a falta era BLOQUEANTE.
# Elas existiam apenas no .env vivo, acrescentadas a mao em algum momento.
# Como o .env e' gerado A PARTIR deste arquivo, toda instalacao limpa
# nascia sem elas e QUEBRAVA em tres pontos, medidos:
#   * scripts/configurar-admin.py       -> "ERRO: EXO_ADMIN_PASS nao definido no .env"
#     (e' o passo 8a da reconstrucao: o assistente de conta inicial)
#   * scripts/reconstruir-do-zero.sh 8d -> sem a conta root nao ha' como
#     autenticar no REST, e o conector de videoconferencia nao e' recriado
#   * tests/run_all.sh linha 26         -> ${EXO_ADMIN_PASS:?defina EXO_ADMIN_PASS no .env}
#     aborta a suite de testes INTEIRA
EXO_ADMIN_USER=root
# A senha NAO fica neste arquivo versionado: e' um placeholder, substituido
# por scripts/gerar-segredos.sh. Para reaproveitar uma senha ja' conhecida
# (continuidade com uma instalacao existente), exporte EXO_ADMIN_PASS antes
# de rodar o script; sem isso, uma senha ALEATORIA e' gerada e IMPRESSA.
EXO_ADMIN_PASS=__EXO_ADMIN_PASS__
# Conta nomeada de uso diario, criada alem da conta 'root' de servico.
EXO_ADMIN_CONTA_NOMEADA=saexo
